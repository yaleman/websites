{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"**",
			"!*.json",
			"!!node_modules/",
			"!!target/*",
			"!!rendered/*",
			"!!admin-ui-assets/*",
			"!!assets/admin/openapi.ts"
		],
		"ignoreUnknown": true,
		"maxSize": 1000000
	},
	"html": {
		"parser": {
			"interpolation": true
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}