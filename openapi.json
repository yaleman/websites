    "version": "0.1.0"
  },
  "paths": {
    "/api/site/{site_id}/assets/library": {
      "get": {
        "tags": [],
        "operationId": "api_site_assets_library",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "description": "The ID of the site to list assets for",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Optional search query to filter assets by original filename or storage basename",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Optional filter by image type (jpeg, png, gif, svg, webp)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of assets matching the query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetLibraryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - insufficient permissions",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AssetLibraryItem": {
        "type": "object",
        "required": [
          "id",
          "original_filename",
          "mime_type",
          "created_at",
          "original_url",
          "has_thumbnail"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "has_thumbnail": {
            "type": "boolean"
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mime_type": {
            "type": "string"
          },
          "original_filename": {
            "type": "string"
          },
          "original_url": {
            "type": "string"
          },
          "thumbnail_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "AssetLibraryResponse": {
        "type": "object",
        "required": [
          "assets"
        ],
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetLibraryItem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer_auth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "websites",
      "description": ""
    }
  ]
